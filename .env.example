# Copy to .env and fill in real values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# Model for ingest-time metadata extraction (Module 4). Kept separate from
# ANTHROPIC_MODEL on purpose: metadata feeds the embedding input, so it is part
# of the config fingerprint -- tying it to the chat model would mean swapping
# the chat model marks the whole corpus stale and re-embeds it.
METADATA_MODEL=claude-haiku-4-5

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_sk_...
LANGSMITH_PROJECT=trag-module-1
# US workspaces: https://api.smith.langchain.com (the SDK default)
# EU workspaces (eu.smith.langchain.com): https://eu.api.smith.langchain.com
# Wrong region returns 403, which is indistinguishable from a bad key.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Required for org-scoped keys. Find it in the dashboard URL:
# https://eu.smith.langchain.com/o/<THIS-IS-THE-WORKSPACE-ID>/settings/apikeys
LANGSMITH_WORKSPACE_ID=

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=26214400

# Retrieval (Module 2). Anthropic has no embeddings endpoint; embeddings and
# figure captioning run on a local Ollama daemon, which must be running.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Must match the vector(768) column in supabase/migrations/0002_retrieval.sql.
# Changing the model means a new migration and re-embedding everything.
EMBEDDING_DIM=768
VLM_MODEL=qwen2.5vl:7b
# VLM captions for figures/charts during ingest. Off = much faster, but charts
# become unsearchable.
DESCRIBE_PICTURES=true
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=5
# Measured 2026-07-30: inert across 0.15-0.50 on the current corpus (every
# relevant chunk scores 0.53+). Do not tune without a golden-set run.
RETRIEVAL_MIN_SIMILARITY=0.30

# Hybrid retrieval (Module 6). Defaults set from the eval table, not on
# principle. Hybrid = a Postgres full-text channel fused with the vector
# channel by RRF; measured strictly better than vector alone (passage hit
# 83.3% -> 100%, mrr 0.929 -> 1.000), because the two channels fail on
# different questions. Reranking re-scores the shortlist with a local
# cross-encoder. It measured identical to RRF on ranking (RRF already
# saturates a 7-question set) but it is on for a different reason: cosine
# similarity cannot tell a real question from gibberish here (0.50 vs 0.48),
# so the cross-encoder is the only thing that can decide when to decline.
RETRIEVAL_HYBRID=true
RERANK_ENABLED=true
# RRF damping constant from the original paper; larger rewards agreement
# between channels over a strong showing in just one.
RRF_K=60
# Candidates fetched per channel before fusion, and read by the reranker.
RERANK_CANDIDATES=20
# ~90MB, English, 30-80ms for 20 passages on CPU. BAAI/bge-reranker-v2-m3
# scores better but is XLM-R-large -- seconds per query without a GPU.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Measured, not guessed: answerable queries score -5.53..+7.28 on the top hit,
# absent ones -10.94..-8.14. No overlap; -7.0 sits in the gap. The obvious
# guess of 0.0 would reject 4 of 7 real questions. Re-measure as the corpus grows.
RERANK_MIN_SCORE=-7.0
# How far below the best hit a passage may score and still be shown. Measured:
# must keep gap 4.29 (a real must_contain passage), must drop gap 11.14
# (unrelated chunks riding along on a name query). Empty disables it.
RERANK_RELATIVE_DROP=8.0
MAX_TOOL_TURNS=5

# Evaluation harness (backend/evaluation). The account whose corpus the golden
# set is written against; the harness signs in as this user so RLS applies
# exactly as it does in the app. No service_role key is used or wanted.
EVAL_USER=you@example.com
EVAL_PASSWORD=

# Frontend (Vite) - only VITE_ prefixed vars reach the browser.
# Never put ANTHROPIC_API_KEY here; it would be bundled into client JS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_API_BASE_URL=http://localhost:8000
