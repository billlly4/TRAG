# Copy to .env and fill in real values. Never commit .env.

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5
# Model for ingest-time metadata extraction (Module 4). Kept separate from
# ANTHROPIC_MODEL on purpose: metadata feeds the embedding input, so it is part
# of the config fingerprint -- tying it to the chat model would mean swapping
# the chat model marks the whole corpus stale and re-embeds it.
METADATA_MODEL=claude-haiku-4-5

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_sk_...
LANGSMITH_PROJECT=trag-module-1
# US workspaces: https://api.smith.langchain.com (the SDK default)
# EU workspaces (eu.smith.langchain.com): https://eu.api.smith.langchain.com
# Wrong region returns 403, which is indistinguishable from a bad key.
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Required for org-scoped keys. Find it in the dashboard URL:
# https://eu.smith.langchain.com/o/<THIS-IS-THE-WORKSPACE-ID>/settings/apikeys
LANGSMITH_WORKSPACE_ID=

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Backend
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_BYTES=26214400

# Retrieval (Module 2). Anthropic has no embeddings endpoint; embeddings and
# figure captioning run on a local Ollama daemon, which must be running.
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Must match the vector(768) column in supabase/migrations/0002_retrieval.sql.
# Changing the model means a new migration and re-embedding everything.
EMBEDDING_DIM=768
VLM_MODEL=qwen2.5vl:7b
# VLM captions for figures/charts during ingest. Off = much faster, but charts
# become unsearchable.
DESCRIBE_PICTURES=true
CHUNK_TARGET_TOKENS=800
CHUNK_OVERLAP_TOKENS=120
RETRIEVAL_TOP_K=5
# A guess until the Module 9 golden set exists. Measure before tuning.
RETRIEVAL_MIN_SIMILARITY=0.30
MAX_TOOL_TURNS=5

# Frontend (Vite) - only VITE_ prefixed vars reach the browser.
# Never put ANTHROPIC_API_KEY here; it would be bundled into client JS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_API_BASE_URL=http://localhost:8000
