# SERVER .env for the deployed API. Copy to `.env` ON THE VM.
#
# This is a SUBSET, not a replacement for .env.example -- that file documents
# the full local setup and every tuned default with the measurement behind it.
# Anything omitted here keeps its default from backend/app/config.py.
#
# What is deliberately NOT here: INGEST_WORKER_*, EXTRACTOR_URL, VLM_MODEL,
# DESCRIBE_PICTURES, EVAL_*. Those belong to ingestion, which runs on the
# machine with the GPU. Putting the worker credentials here would let this
# container claim jobs it has no docling, no vision model and no GPU to finish.

# --- Public hostname --------------------------------------------------------
# Caddy's site address. It requests a certificate for this name automatically
# once DNS points at the VM. Read by the caddy container, not by the API.
DOMAIN=trag.example.com

# --- Supabase (the same project as local) -----------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Ollama -----------------------------------------------------------------
# docker-compose.yml overrides this to http://ollama:11434 -- inside the
# compose network the loopback default would point the API at its own container.
# Only nomic-embed-text is pulled: query embeddings. Captioning is ingestion.
OLLAMA_BASE_URL=http://ollama:11434

# --- CORS -------------------------------------------------------------------
# Caddy serves the frontend and proxies /api on the SAME origin, so the deployed
# app never makes a cross-origin request and this is not exercised. It still
# matters if you point a local `npm run dev` at this API.
CORS_ORIGINS=https://trag.example.com

# --- Frontend build ---------------------------------------------------------
# Read by `npm run build`, NOT by the API. Vite inlines these into the bundle at
# build time: changing them and restarting does nothing, you must rebuild.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Same origin as the site, so requests are relative and CORS never fires.
VITE_API_BASE_URL=https://trag.example.com
# Hides the "Need an account? Sign up" toggle. Presentation only -- the control
# that matters is Supabase's own signup setting, which should already be off.
VITE_ALLOW_SIGNUP=false

# --- Observability (optional) -----------------------------------------------
# Off by default here: tracing every public request costs LangSmith quota and
# records strangers' questions.
LANGSMITH_TRACING=false
